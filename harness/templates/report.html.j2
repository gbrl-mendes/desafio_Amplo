<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Relatório de execução — desafio_Amplo</title>
<style>
  /* Paleta e tipografia derivadas do tema "Cayman" (prettydoc) usado no
     relatorio em PDF (ver harness/pdf_report.py) -- mesma identidade visual
     nos dois formatos. Sem link pro Google Fonts aqui: diferente do PDF
     (gerado uma vez, com internet disponivel), este HTML precisa continuar
     abrindo e funcionando sem internet depois de pronto -- ver docstring
     deste modulo. */
  :root {
    --cayman-blue: #155799;
    --cayman-green: #159957;
    --text: #606c71;
    --text-strong: #1a1a1a;
    --border: #e9ebec;
    --stripe: #f2f4f7;
    --sidebar-width: 260px;
  }
  * { box-sizing: border-box; }
  /* CSS vendorizado do DataTables carregado ANTES das nossas regras de
     tabela (mais abaixo) de proposito: elas precisam vencer no cascade
     (mesma especificidade, ordem decide) pra sobrescrever o cabecalho
     padrao do DataTables com as cores do tema. */
  {{ datatables_css }}
  body {
    margin: 0; color: var(--text); background: #fff;
    font-family: "Open Sans", "Helvetica Neue", Helvetica, Arial, sans-serif;
    line-height: 1.5;
  }
  a { color: var(--cayman-blue); }

  /* --- Navegacao lateral, estilo MultiQC: titulos de cada secao, clicar
     leva ate ela (ancora comum); destaca a secao visivel no momento via
     IntersectionObserver (ver script no fim do body). --- */
  .sidebar {
    position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-width);
    background-image: linear-gradient(160deg, var(--cayman-blue), var(--cayman-green));
    color: #fff; overflow-y: auto; z-index: 10;
  }
  .sidebar .brand {
    padding: 1.5rem 1.5rem 1rem; font-size: 1.05rem; font-weight: 700;
    border-bottom: 1px solid rgba(255, 255, 255, .25); margin-bottom: .5rem;
  }
  .sidebar .brand small { display: block; font-weight: 400; opacity: .75; font-size: .75rem; margin-top: .3rem; }
  /* Botao de acao (abre a pasta desta execucao numa aba nova) -- estilo de
     pilula, visualmente diferente dos links de navegacao abaixo (que so
     rolam a pagina) porque faz algo categoricamente diferente. */
  .sidebar .open-folder-link {
    display: flex; align-items: center; gap: .4rem; margin: 1rem 1.5rem 1.25rem;
    padding: .5rem .9rem; border: 1px solid rgba(255, 255, 255, .4); border-radius: 999px;
    color: #fff; text-decoration: none; font-size: .82rem; font-weight: 600;
    background: rgba(255, 255, 255, .08);
  }
  .sidebar .open-folder-link:hover { background: rgba(255, 255, 255, .2); }
  .sidebar nav a {
    display: block; padding: .6rem 1.5rem; color: rgba(255, 255, 255, .85);
    text-decoration: none; font-size: .86rem; border-left: 3px solid transparent;
  }
  .sidebar nav a:hover { background: rgba(255, 255, 255, .1); color: #fff; }
  .sidebar nav a.active { background: rgba(255, 255, 255, .16); border-left-color: #fff; color: #fff; font-weight: 600; }

  .main-content { margin-left: var(--sidebar-width); max-width: 1400px; padding-bottom: 4rem; }

  .page-header {
    color: #fff; text-align: center; background-color: var(--cayman-green);
    background-image: linear-gradient(120deg, var(--cayman-blue), var(--cayman-green));
    padding: 2rem 2rem 1.75rem;
  }
  .page-header h1 { margin: 0 0 .3rem; font-size: 1.6rem; font-weight: 400; }
  .page-header .meta { opacity: .85; font-size: .95rem; }

  section { padding: 1.5rem 2.5rem; border-bottom: 1px solid var(--border); scroll-margin-top: 1rem; }
  section h2 { margin-top: 0; font-size: 1.25rem; font-weight: 400; color: var(--cayman-green); }
  .warning-banner { background: #fff3cd; border: 1px solid #ffe69c; color: #664d03; padding: 1rem 1.5rem; margin: 1.5rem 2.5rem 0; border-radius: 6px; }
  .stage-block { margin-bottom: 1.25rem; }
  .stage-block h3 { margin-bottom: .35rem; font-size: 1rem; color: var(--text-strong); }
  .stage-block dl { display: grid; grid-template-columns: max-content 1fr; gap: .25rem 1rem; margin: 0; font-size: .9rem; }
  .stage-block dt { font-weight: 600; color: #444; }
  .stage-block dd { margin: 0; }
  .empty-note { color: #888; font-style: italic; }
  .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .75rem; }
  .summary-grid .stat { background: var(--stripe); border-radius: 6px; padding: .75rem 1rem; }
  .summary-grid .stat .value { font-size: 1.4rem; font-weight: 700; color: var(--text-strong); }
  .summary-grid .stat .label { font-size: .8rem; color: #666; }
  .flags { margin-top: .75rem; font-size: .85rem; color: #555; }
  .divergence-case { border-left: 3px solid var(--cayman-green); padding-left: .75rem; margin-bottom: .75rem; font-size: .9rem; }
  iframe.plot-frame { width: 100%; height: 520px; border: 1px solid var(--border); border-radius: 6px; }

  /* --- Tabelas: a pedido explicito, largura sempre limitada a do
     container (nunca estoura a pagina) e com sua PROPRIA barra de rolagem
     horizontal quando o conteudo e mais largo -- DataTables faz isso
     nativamente via scrollX (ver script de inicializacao abaixo). --- */
  .table-scroll { max-width: 100%; margin: 1rem 0; }
  table.dataTable { width: 100% !important; font-size: .82rem; }
  table.dataTable thead th { background: var(--cayman-green); color: #fff; }
  .dt-scroll-head { background: var(--cayman-green); }

  .narrative { line-height: 1.6; font-size: .95rem; }
  .narrative h1, .narrative h2, .narrative h3 { font-size: 1.05rem; margin: 1rem 0 .4rem; color: var(--cayman-green); font-weight: 600; }
  .narrative table { border-collapse: collapse; margin: .5rem 0; }
  .narrative th, .narrative td { border: 1px solid var(--border); padding: .3rem .6rem; }
  .narrative code { background: var(--stripe); padding: .1rem .3rem; border-radius: 3px; font-size: .85em; }

  @media (max-width: 860px) {
    .sidebar { position: static; width: 100%; height: auto; }
    .main-content { margin-left: 0; }
    section { padding: 1.25rem 1.25rem; }
    .page-header { padding: 1.5rem 1.25rem; }
  }
</style>
<script>{{ jquery_js }}</script>
<script>{{ datatables_js }}</script>
</head>
<body>

{% macro render_table(table) %}
{% if table %}
<div class="table-scroll">
  <table id="{{ table.id }}" class="display" style="width:100%">
    <thead><tr>{% for col in table.columns %}<th>{{ col }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for row in table.rows %}
      <tr>{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<script>$(function () { $('#{{ table.id }}').DataTable({ scrollX: true, scrollCollapse: true }); });</script>
{% else %}
<p class="empty-note">Seção não disponível.</p>
{% endif %}
{% endmacro %}

{#- Secoes realmente renderizadas nesta execucao -- usado tanto pra montar
    a navegacao lateral quanto pros ids usados pelas ancoras/scrollspy,
    seguindo exatamente os mesmos "if" que decidem o que aparece abaixo. -#}
{% set sections = [] %}
{% set _ = sections.append(("resumo-geral", "Resumo geral")) %}
{% if not is_somente %}
  {% set _ = sections.append(("tabela-entrada", "Tabela de entrada bruta")) %}
  {% set _ = sections.append(("curadoria-deterministica", "Curadoria determinística")) %}
  {% set _ = sections.append(("tabela-deterministica", "Saída determinística")) %}
  {% set _ = sections.append(("curadoria-llm", "Curadoria assistida por LLM")) %}
{% endif %}
{% set _ = sections.append(("tabela-final", "Tabela final")) %}
{% if ecologia_plots or ecologia_requested %}
  {% set _ = sections.append(("analise-ecologica", "Análise ecológica")) %}
{% endif %}

<aside class="sidebar">
  <div class="brand">
    desafio_Amplo
    <small>{{ "Somente análise ecológica" if is_somente else "Execução completa" }}</small>
  </div>
  {#- Link relativo (".") -- aponta pra pasta que contem este proprio
      arquivo HTML, ou seja, a pasta desta execucao (runs/<run_id>/), onde
      moram o CSV final, o PDF e a pasta ecologia/. Sem caminho absoluto de
      proposito: continua correto mesmo se a pasta for copiada/movida.
      target="_blank" abre numa aba nova, sem perder o lugar no relatorio. #}
  <a class="open-folder-link" href="." target="_blank" rel="noopener" title="Abrir a pasta desta execução (CSV, PDF, gráficos)">
    📁 Abrir pasta desta execução
  </a>
  <nav>
    {% for anchor, title in sections %}
    <a href="#{{ anchor }}" data-nav-target="{{ anchor }}">{{ title }}</a>
    {% endfor %}
  </nav>
</aside>

<div class="main-content">
  <div class="page-header">
    <h1>Relatório de execução</h1>
    <div class="meta">
      {% if researcher %}{{ researcher }}{% endif %}
      {% if project %} &middot; {{ project }}{% endif %}
      {% if primer %} &middot; primer {{ primer }}{% endif %}
      {% if started_at %} &middot; {{ started_at }}{% endif %}
    </div>
  </div>

  {% if is_somente %}
  <div class="warning-banner">
    Esta análise partiu de um CSV já curado por uma execução anterior, possivelmente revisado à mão, fora de uma execução completa desta vez — as seções de entrada bruta e de resumo da curadoria determinística não se aplicam aqui.
  </div>
  {% endif %}

  <section id="resumo-geral">
    <h2>Resumo geral</h2>
    {% if metadata_summary %}
    <div class="summary-grid">
      {% if metadata_summary.amostras is not none %}<div class="stat"><div class="value">{{ metadata_summary.amostras }}</div><div class="label">Amostras</div></div>{% endif %}
      {% if metadata_summary.amostras_reais is not none %}<div class="stat"><div class="value">{{ metadata_summary.amostras_reais }}</div><div class="label">Amostras reais</div></div>{% endif %}
      {% if metadata_summary.controles is not none %}<div class="stat"><div class="value">{{ metadata_summary.controles }}</div><div class="label">Controles</div></div>{% endif %}
      {% if metadata_summary.pontos_unicos is not none %}<div class="stat"><div class="value">{{ metadata_summary.pontos_unicos }}</div><div class="label">Pontos únicos</div></div>{% endif %}
      {% if metadata_summary.data_min and metadata_summary.data_max %}<div class="stat"><div class="value" style="font-size:1rem;">{{ metadata_summary.data_min }} – {{ metadata_summary.data_max }}</div><div class="label">Faixa de datas</div></div>{% endif %}
    </div>
    <div class="flags">
      Latitude/Longitude: {{ "presente" if metadata_summary.tem_latitude else "ausente" }} &middot;
      Habitat: {{ "presente" if metadata_summary.tem_habitat else "ausente" }} &middot;
      Rios: {{ "presente" if metadata_summary.tem_rios else "ausente" }}
    </div>
    {% else %}
    <p class="empty-note">Seção não disponível.</p>
    {% endif %}
  </section>

  {% if not is_somente %}
  <section id="tabela-entrada">
    <h2>Tabela de entrada bruta</h2>
    {{ render_table(input_table) }}
  </section>

  <section id="curadoria-deterministica">
    <h2>Curadoria determinística</h2>
    {% if diagnostics %}
      {% if diagnostics.refinamento_hits %}
      <div class="stage-block">
        <h3>Refinamento dos hits de BLAST</h3>
        <dl>
          <dt>Origem do hit selecionado</dt><dd>{{ diagnostics.refinamento_hits.selected_hit_origin }}</dd>
          <dt>Hits não confiáveis (Match_not_reliable)</dt><dd>{{ diagnostics.refinamento_hits.match_not_reliable_count }} de {{ diagnostics.refinamento_hits.total_linhas }}</dd>
        </dl>
      </div>
      {% endif %}
      {% if diagnostics.taxonomia_contaminacao %}
      <div class="stage-block">
        <h3>Taxonomia NCBI + contaminação</h3>
        <dl><dt>Status de contaminação</dt><dd>{{ diagnostics.taxonomia_contaminacao.contamination_status }}</dd></dl>
      </div>
      {% endif %}
      {% if diagnostics.curadoria_final %}
      <div class="stage-block">
        <h3>Curadoria final</h3>
        <dl>
          <dt>Faixa de amplicon</dt><dd>{{ diagnostics.curadoria_final.primer_expected_length }}</dd>
          <dt>Identificação máxima</dt><dd>{{ diagnostics.curadoria_final.identification_max_taxonomy }}</dd>
          <dt>Grupos de táxons-alvo</dt><dd>{{ diagnostics.curadoria_final.taxons_alvo_grupos }}</dd>
          <dt>Possible target taxon</dt><dd>{{ diagnostics.curadoria_final.possible_target_taxon }}</dd>
        </dl>
      </div>
      {% endif %}
      {% if diagnostics.arvore_filogenetica %}
      <div class="stage-block">
        <h3>Árvore filogenética</h3>
        <dl><dt>Vizinhos calculados</dt><dd>{{ diagnostics.arvore_filogenetica.vizinhos_calculados }} de {{ diagnostics.arvore_filogenetica.total_linhas }} linhas</dd></dl>
      </div>
      {% endif %}
      {% if diagnostics.checagem_regional %}
      <div class="stage-block">
        <h3>Checagem regional (GBIF)</h3>
        <dl>
          <dt>Linhas consultadas</dt><dd>{{ diagnostics.checagem_regional.gbif_consultadas }}</dd>
          {% if diagnostics.checagem_regional.pulada %}<dt>Pulada</dt><dd>{{ diagnostics.checagem_regional.motivo }}</dd>{% endif %}
        </dl>
      </div>
      {% endif %}
    {% else %}
    <p class="empty-note">Seção não disponível.</p>
    {% endif %}
  </section>

  <section id="tabela-deterministica">
    <h2>Tabela de saída determinística (antes da curadoria assistida)</h2>
    {{ render_table(deterministic_table) }}
  </section>

  <section id="curadoria-llm">
    <h2>Curadoria assistida por LLM</h2>
    {% if report_html %}
      <div class="narrative">{{ report_html }}</div>
    {% elif llm_reviewed_count is not none %}
      <p>{{ llm_reviewed_count }} de {{ llm_total_unique_asvs }} ASVs únicas revisadas.</p>
    {% else %}
      <p class="empty-note">Seção não disponível.</p>
    {% endif %}
    {% if llm_divergence_examples %}
      <h3 style="margin-top:1rem;">Casos de divergência</h3>
      {% for ex in llm_divergence_examples %}
      <div class="divergence-case">
        <strong>{{ ex['ASV header'] }}</strong>: {{ ex['Identification'] }} → {{ ex['Assisted ID (LLM)'] }}
        (confiança {{ ex['Assisted Confidence (LLM)'] }})<br>
        <span style="color:#555;">{{ ex['Assisted Justification (LLM)'] }}</span>
      </div>
      {% endfor %}
    {% endif %}
  </section>
  {% endif %}

  <section id="tabela-final">
    <h2>Tabela final</h2>
    {{ render_table(final_table) }}
  </section>

  {% if ecologia_plots %}
  <section id="analise-ecologica">
    <h2>Análise ecológica</h2>
    {% for plot in ecologia_plots %}
    <div class="stage-block">
      <h3>{{ plot.title }}</h3>
      {% if plot.kind == "html" %}
        <iframe class="plot-frame" srcdoc="{{ plot.content }}"></iframe>
      {% else %}
        <img src="{{ plot.content }}" style="max-width:100%; border:1px solid var(--border); border-radius:6px;">
      {% endif %}
    </div>
    {% endfor %}
  </section>
  {% elif ecologia_requested %}
  <section id="analise-ecologica">
    <h2>Análise ecológica</h2>
    <p class="empty-note">Seção não disponível.</p>
  </section>
  {% endif %}
</div>

<script>
// Scrollspy simples, estilo MultiQC: destaca na navegacao lateral a secao
// visivel no momento, sem nenhuma biblioteca externa.
(function () {
  var links = document.querySelectorAll(".sidebar nav a[data-nav-target]");
  if (!links.length || !("IntersectionObserver" in window)) return;

  var linkByTarget = {};
  links.forEach(function (link) { linkByTarget[link.getAttribute("data-nav-target")] = link; });

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      var link = linkByTarget[entry.target.id];
      if (!link) return;
      if (entry.isIntersecting) {
        links.forEach(function (l) { l.classList.remove("active"); });
        link.classList.add("active");
      }
    });
  }, { rootMargin: "-15% 0px -70% 0px" });

  Object.keys(linkByTarget).forEach(function (id) {
    var section = document.getElementById(id);
    if (section) observer.observe(section);
  });
})();
</script>
</body>
</html>
