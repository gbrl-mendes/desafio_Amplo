# Chave de API gratuita da Groq (https://console.groq.com/keys), usada pela
# etapa de curadoria assistida por LLM (harness/llm_curation.py) e pelo
# relatorio narrativo (harness/report_generation.py).
#
# Copie este arquivo para .env e preencha com a sua propria chave -- .env e
# local, nunca commitado (ver .gitignore). Sem chave configurada (nem aqui,
# nem em --groq-api-key, nem na variavel de ambiente GROQ_API_KEY), as duas
# etapas sao puladas automaticamente e o resto do pipeline roda normalmente.
GROQ_API_KEY=sua-chave-aqui
GROQ_MODEL=openai/gpt-oss-120b
